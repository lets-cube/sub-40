{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/eqeqeq": ["error", "always"],
    "eslint/curly": ["error", "all"],
    "eslint/one-var": ["error", "never"],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**"],
  "overrides": [
    {
      "files": ["src/cube/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "**/app/**",
                  "**/features/**",
                  "**/shared/**",
                  "**/data/**"
                ],
                "message": "Le moteur du cube reste indépendant de React, de l’interface et du contenu pédagogique."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/app/**", "**/features/**"],
                "message": "Le socle partagé ne dépend pas des écrans ou de la composition de l’application."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/app/**"],
                "message": "Les fonctionnalités ne dépendent pas de la couche qui les assemble."
              }
            ]
          }
        ]
      }
    }
  ]
}
