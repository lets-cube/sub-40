{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "bun.lock",
    "public/fonts/**",
    "public/favicon.svg"
  ]
}
